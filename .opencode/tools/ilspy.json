{
  "name": "ilspy",
  "description": "Decompile .NET assemblies using ILSpy command-line tool. Supports outputting C# source code or IL (Intermediate Language) from DLL/EXE files.",
  "command": "ilspycmd",
  "arguments": [
    {
      "name": "assembly",
      "description": "Path to the .NET assembly file (DLL or EXE) to decompile",
      "type": "string",
      "required": true
    },
    {
      "name": "output",
      "description": "Output directory or file path for decompiled code",
      "type": "string",
      "required": false,
      "flag": "-o"
    },
    {
      "name": "language",
      "description": "Output language format",
      "type": "enum",
      "options": ["cs", "il"],
      "default": "cs",
      "required": false,
      "flag": "--il"
    },
    {
      "name": "project",
      "description": "Generate a .csproj project file for the decompiled code",
      "type": "boolean",
      "required": false,
      "flag": "-p"
    },
    {
      "name": "types",
      "description": "Comma-separated list of type names to decompile (wildcards supported with *)",
      "type": "string",
      "required": false,
      "flag": "-t"
    },
    {
      "name": "excludeTypes",
      "description": "Comma-separated list of type names to exclude from decompilation",
      "type": "string",
      "required": false,
      "flag": "--exclude-types"
    },
    {
      "name": "recursive",
      "description": "Recurse into all nested assemblies in the input directory",
      "type": "boolean",
      "required": false,
      "flag": "-r"
    },
    {
      "name": "noResume",
      "description": "Do not resume a partial decompilation session",
      "type": "boolean",
      "required": false,
      "flag": "--no-resume"
    },
    {
      "name": "decompileAnonymousMethods",
      "description": "Decompile anonymous methods/lambdas",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-anon-methods"
    },
    {
      "name": "decompileExpressionTrees",
      "description": "Decompile expression trees",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-expr-trees"
    },
    {
      "name": "decompileAsyncMethods",
      "description": "Decompile async methods",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-async"
    },
    {
      "name": "decompileEnumerators",
      "description": "Decompile enumerators/yield return",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-enums"
    },
    {
      "name": "decompileAutoProperties",
      "description": "Decompile automatically implemented properties",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-auto-props"
    },
    {
      "name": "decompileAutoEvents",
      "description": "Decompile automatically implemented events",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-auto-events"
    },
    {
      "name": "decompileUsingDeclarations",
      "description": "Decompile using declarations",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-using"
    },
    {
      "name": "decompileAnonymousTypes",
      "description": "Decompile anonymous types",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-anon-types"
    },
    {
      "name": "decompileQueryExpressions",
      "description": "Decompile query expressions",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-queries"
    },
    {
      "name": "decompileLock",
      "description": "Decompile lock statements",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-lock"
    },
    {
      "name": "decompileSwitchOnString",
      "description": "Decompile switch on string",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-switch-string"
    },
    {
      "name": "decompileDelegateConstruction",
      "description": "Decompile delegate construction",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-delegates"
    },
    {
      "name": "decompileUnsafeCode",
      "description": "Decompile unsafe code (pointers, fixed statements)",
      "type": "boolean",
      "default": true,
      "required": false,
      "flag": "--decompile-unsafe"
    },
    {
      "name": "alwaysGenerateExceptionVariableForCatchBlocks",
      "description": "Always generate exception variable in catch blocks",
      "type": "boolean",
      "default": false,
      "required": false,
      "flag": "--catch-exceptions"
    },
    {
      "name": "referencePaths",
      "description": "Additional reference assembly paths for better decompilation (semicolon-separated)",
      "type": "string",
      "required": false,
      "flag": "--reference-path"
    },
    {
      "name": "help",
      "description": "Show help information",
      "type": "boolean",
      "required": false,
      "flag": "-h"
    }
  ],
  "examples": [
    {
      "description": "Decompile a single assembly to current directory",
      "usage": "ilspy assembly.dll"
    },
    {
      "description": "Decompile to specific output directory",
      "usage": "ilspy assembly.dll -o ./decompiled"
    },
    {
      "description": "Generate IL code instead of C#",
      "usage": "ilspy assembly.dll --language il"
    },
    {
      "description": "Generate a project file and decompile all types",
      "usage": "ilspy assembly.dll -p -o ./project"
    },
    {
      "description": "Decompile only specific types matching a pattern",
      "usage": "ilspy assembly.dll -t 'Namespace.ClassName' -o ./filtered"
    },
    {
      "description": "Decompile with specific types excluded",
      "usage": "ilspy assembly.dll --exclude-types 'Internal.*' -o ./public"
    }
  ],
  "installation": {
    "description": "Install ilspycmd as a .NET global tool",
    "command": "dotnet tool install --global ilspycmd"
  },
  "requirements": [
    ".NET SDK 6.0 or later",
    "ilspycmd global tool installed"
  ],
  "notes": [
    "ilspycmd is a command-line frontend for the ILSpy decompiler",
    "Output quality depends on the assembly's obfuscation level",
    "Some constructs may not decompile cleanly if the code was heavily optimized",
    "Reference paths help resolve external dependencies for more accurate decompilation"
  ]
}
